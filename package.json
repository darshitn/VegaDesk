{
  "name": "jarvis-dashboard",
  "version": "1.0.0",
  "description": "Vega Dashboard Desktop App",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && pip install -r backend/requirements.txt",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "pyinstaller --name jarvis-backend --onefile --distpath dist backend/run.py",
    "build:win": "npm run build:backend && npm run build --prefix frontend && npm run pack --prefix frontend",
    "seed:beta": "node scripts/seed_beta.js",
    "dev:beta": "node scripts/launch_beta.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
