{
  "name": "jarvis-dashboard",
  "version": "0.1.0-beta.1",
  "description": "Vega Dashboard Desktop App",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && pip install -r backend/requirements.txt",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "node scripts/build_release.js --backend-only",
    "build:win": "node scripts/build_release.js",
    "build:win:dir": "node scripts/build_release.js --dir",
    "seed:beta": "node scripts/seed_beta.js",
    "dev:beta": "node scripts/launch_beta.js",
    "dev:beta:voice": "node scripts/launch_beta.js --voice",
    "dev:beta:ollama": "node scripts/launch_beta.js --ollama",
    "dev:beta:ollama:voice": "node scripts/launch_beta.js --ollama --voice"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
